#!/bin/sh
# ============================================================================
# Console entry for GROL5000.
# Still launches the Home Assistant compatibility CLI container when ready.
# The ASCII banner inside that container is owned by plugin-cli, not this OS.
# ============================================================================

run_shell() { exec /bin/ash -l; }
interrupt() { echo " cancelled"; systemctl reset-failed "ha-cli@*"; run_shell; }
emergency_shell() {
    printf "\n\n[WARNING] Home Assistant compatibility CLI is not starting.\n"
    echo ""
    echo "GROL5000 is up. Supervisor or the CLI container is just slow."
    echo "Useful commands:"
    echo ""
    echo " * 'docker ps -a'"
    echo " * 'journalctl -e'"
    echo " * 'exit' or Ctrl+D to retry the CLI"
    echo ""
    run_shell
}

trap interrupt INT

printf "\n"
printf "  GROL5000 OS\n"
printf "  Global Robotic Overlord Logic\n"
printf "\n"
printf "Waiting for Home Assistant compatibility CLI..."

i=0
while [ ! "$(docker ps -q -f name=hassio_cli)" ]; do
    sleep 1

    if [ $((i % 4)) = 0 ]; then
        printf "\010\010\010   \010\010\010"
    else
        printf "."
    fi

    i=$((i+1))

    if [ $i = 180 ]; then
        emergency_shell
    fi
done

docker container exec \
    -ti hassio_cli \
    /usr/bin/cli.sh

case $? in
  10)
    run_shell
    ;;
  130)
    printf "\nCompatibility CLI interrupted.\n"
    systemctl reset-failed "ha-cli@*"
    ;;
  143)
    printf "\nCompatibility CLI terminated.\n"
    ;;
  *)
    printf "\nCompatibility CLI failed with error code: %s\n" "$?"
    ;;
esac
