#!/bin/sh
# GROL5000 tty console.
# Does not auto-enter the inherited hassio_cli container.
# Type `ha` for that compatibility CLI.

export PS1='grol > '

grol_ip() {
    ip -4 -o addr show scope global 2>/dev/null \
        | awk '{print $4}' \
        | cut -d/ -f1 \
        | head -n1
}

grol_cli_state() {
    if command -v docker >/dev/null 2>&1 && docker ps -q -f name=hassio_cli >/dev/null 2>&1; then
        if [ -n "$(docker ps -q -f name=hassio_cli)" ]; then
            echo Active
            return
        fi
    fi
    echo Starting
}

grol_supervisor_state() {
    if command -v docker >/dev/null 2>&1; then
        if [ -n "$(docker ps -q -f name=hassio_supervisor)" ]; then
            echo Online
            return
        fi
    fi
    echo Starting
}

grol_status() {
    ipaddr=$(grol_ip)
    [ -n "$ipaddr" ] || ipaddr=waiting
    printf '\n'
    printf '  GROL5000 OS\n'
    printf '  Global Robotic Overlord Logic\n'
    printf '\n'
    printf '  Network:     %s\n' "$ipaddr"
    if [ "$ipaddr" != waiting ]; then
        printf '  Web UI:      http://%s:8123\n' "$ipaddr"
    else
        printf '  Web UI:      http://<ip>:8123\n'
    fi
    printf '  Supervisor:  %s\n' "$(grol_supervisor_state)"
    printf '  HA CLI:      %s\n' "$(grol_cli_state)"
    printf '\n'
    printf '  ha      inherited Home Assistant CLI\n'
    printf '  status  reprint this card\n'
    printf '  shell   busybox ash\n'
    printf '\n'
}

ha() {
    if [ -z "$(docker ps -q -f name=hassio_cli 2>/dev/null)" ]; then
        echo 'hassio_cli is not running yet.'
        return 1
    fi
    docker container exec -ti hassio_cli /usr/bin/cli.sh
}

status() { grol_status; }

shell() { exec /bin/ash -l; }

trap 'printf "\n"; exec /bin/ash -l' INT

clear 2>/dev/null || true
grol_status

# Interactive appliance prompt. Keep this a login-capable shell so
# recovery still works if Docker is down.
exec /bin/ash -i
