[Unit]
Description=GROL Host API
After=local-fs.target systemd-sysusers.service systemd-tmpfiles-setup.service
Before=hassio-supervisor.service

[Service]
Type=simple
User=grol-hostd
Group=grol-hostapi
ExecStart=/usr/bin/grol-hostd --socket /run/grol/hostapi.sock --allowlist /etc/grol/hostapi-allowlist
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LockPersonality=yes
RestrictSUIDSGID=yes
RuntimeDirectory=grol
RuntimeDirectoryMode=0750
# Do not set MemoryDenyWriteExecute — the Go runtime needs executable
# anonymous mappings and will sit in activating/restart under MDWE.

[Install]
WantedBy=multi-user.target
